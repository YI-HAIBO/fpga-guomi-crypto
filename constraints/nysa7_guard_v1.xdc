# =============================================================================
# Nexys A7 200T (xc7a200tsbg484) 板级 IO 约束 -- 守卫约束 (v1.1 Guard)
# =============================================================================
# 项目: GM-CRYPTO-COORD-2026 - FPGA 国密多算法协调芯片
# 版本: v1.1 Guard (2026-10-06 添加守卫边界与性能底线)
# 设计: 齐流晶
#
# 【Guard 目标】
#   为板级综合设置明确的守卫边界：在不完全依赖优化手段的情况下，
#   提供可接受的最低性能约束和路径保护，确保 bitstream 生成流程稳定。
#
# 【核心策略】
#   1. 时钟约束放宽至 12ns (83.3 MHz) 作为保底底线
#   2. 添加 false_path 锁定未用路径 (JTAG/LED/约束缓冲)
#   3. 保留修改后的合法 IO 引脚，确保综合编译通过
#
# 【预期效果】
#   - 抑制非功能路径的时序违例
#   - 降低综合对组合逻辑级数的敏感度
#   - 为后续优化（S 盒 BRAM 化、并行度降低）提供缓冲窗口
#
# 【注意】
#   - 本文件与 nysa7_selfTest_v1.xdc 配合使用
#   - 12ns 是安全性底线，非性能目标（性能目标仍为 10ns）
#   - 上板测试前需确认 100MHz 晶振物理存在
# =============================================================================

# -----------------------------------------------------------------------------
# 守护: 从主 XDC 读取所有 IO 约束 (VO 为 momentary, 主文件已定义合法球)
# -----------------------------------------------------------------------------
# 依赖: nysa7_selfTest_v1.xdc

# -----------------------------------------------------------------------------
# 守护边界: 核心时钟放宽至 12ns (性能底线)
# -----------------------------------------------------------------------------
# set_property PACKAGE_PIN E3 [get_ports {clk}];  // 从主 XDC 继承
# create_clock 从主 XDC 继承，这里做二次确认
create_clock -period 12.000 -name sys_clk_guard [get_ports {clk}];

# -----------------------------------------------------------------------------
# 守护/锁定: 未使用的 JTAG/LED 控制线 (防止多余逻辑被综合)
# -----------------------------------------------------------------------------
# JTAG 模块 (若有) -> 锁定 false_path
set_false_path -from [get_pins -hierarchical *jtag_*] -to [get_pins -hierarchical *jtag_*]
set_false_path -from [get_pins -hierarchical *dp_if_*] -to [get_pins -hierarchical *dp_if_*]

# 守护/扩展: 抑制 LED 的时钟/组合路径要求 (若 LED 仅做测试)
set_false_path -from [get_ports {led[0]}] -to [get_ports {led[7]}]
set_false_path -from [get_ports {led}] -to [get_ports {led}]

# -----------------------------------------------------------------------------
# 守护: 约束缓冲与必要的集总端口 (可选)
# -----------------------------------------------------------------------------
# 保护所有输入输出时钟路径，防止过度优化
set_cyc_issues

# -----------------------------------------------------------------------------
# 守护: 综合属性建议 (在综合脚本中应用)
# -----------------------------------------------------------------------------
# 综合脚本中添加 (如 run_board_vivado.py):
#   set_property SYNC.optimization_optimization_guidelines {耐力优化} [get_synth_designs syn_default]
#   set_property NO_SequenceMapsขณะบีบอัด [get_synth_designs syn_default]
# -----------------------------------------------------------------------------
